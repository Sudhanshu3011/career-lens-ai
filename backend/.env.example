# ==============================================================================
# CareerLens AI - Backend Environment Configuration Example
# ==============================================================================

# Hugging Face Authentication Token for Laya Models
HF_TOKEN=your_hf_token_here
HUGGING_FACE_HUB_TOKEN=your_hf_token_here
HF_HUB_OFFLINE=0

# SerpApi (Optional: for real-time live Google Jobs search; mock fallback is used if omitted)
SERPAPI_API_KEY=your_serpapi_key_here

# Application Configuration
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////app/data/sessions.db
